{
  "name": "@gavmor/foxhole-styles",
  "version": "1.0.0",
  "description": "Foxhole field-paperwork design system: DTCG design tokens, fonts, aged-paper plates, print CSS patterns, and the Homebrewery V3 theme. Shared dependency of the diegetic-docs skill and the Homebrewery fork.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/gavmor/foxhole-styles.git"
  },
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "./dist/tokens.js",
  "types": "./dist/tokens.d.ts",
  "exports": {
    ".": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens.print.css": "./dist/tokens.print.css",
    "./tokens.less": "./dist/tokens.less",
    "./tokens.json": "./dist/tokens.json",
    "./manifest.json": "./dist/manifest.json",
    "./print/foxhole-print.css": "./print/foxhole-print.css",
    "./fonts/*": "./fonts/*",
    "./plate/*": "./plate/*",
    "./theme/*": "./homebrewery/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "tokens/",
    "fonts/",
    "plate/",
    "print/",
    "homebrewery/"
  ],
  "scripts": {
    "validate": "node scripts/validate-tokens.mjs",
    "build": "npm run validate && node scripts/build.mjs",
    "test": "node scripts/check-contract.mjs",
    "check": "npm run build && npm test && git diff --exit-code -- dist",
    "changeset": "changeset",
    "version": "changeset version"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.4",
    "style-dictionary": "^5.6.0"
  }
}
